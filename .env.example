# Backend settings (all are optional for direct local development)
TRIPWISE_DATABASE_URL=sqlite+pysqlite:///./tripwise.db
TRIPWISE_REDIS_URL=redis://localhost:6379/0
TRIPWISE_QUEUE_MODE=inline
TRIPWISE_CORS_ORIGINS=["http://localhost:5173"]
TRIPWISE_WEATHER_PROVIDER=local
TRIPWISE_OPENWEATHER_API_KEY=

# Optional: enables the OpenAI prose/itinerary adapter when configured.
TRIPWISE_OPENAI_ENABLED=false
TRIPWISE_OPENAI_API_KEY=
TRIPWISE_OPENAI_MODEL=gpt-5-mini

# Sign in with ChatGPT (tokens stay in the backend-only project directory)
TRIPWISE_CHATGPT_CREDENTIALS_PATH=.tripwise/chatgpt-credentials.json
TRIPWISE_CHATGPT_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/chatgpt/callback
TRIPWISE_FRONTEND_URL=http://localhost:5173

# Frontend build-time API endpoint
VITE_API_URL=http://localhost:8000/api/v1
